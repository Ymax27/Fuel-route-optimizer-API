# Copy to .env and adjust as needed. Every value has a sane default.
DJANGO_SETTINGS_MODULE=config.settings
DJANGO_SECRET_KEY=change-me-in-production
DJANGO_DEBUG=false
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1

# Routing / geocoding upstreams
OSRM_BASE_URL=https://router.project-osrm.org
NOMINATIM_BASE_URL=https://nominatim.openstreetmap.org
NOMINATIM_USER_AGENT=fuel-route-optimizer-assessment/1.0 (contact: you@example.com)

# Vehicle model
FUEL_RANGE_MILES=500
FUEL_EFFICIENCY_MPG=10
FUEL_START_FULL=true

# Route corridor half-width for candidate stations
CORRIDOR_RADIUS_MILES=15
